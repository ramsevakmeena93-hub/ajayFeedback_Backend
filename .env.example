MONGO_URI=mongodb://localhost:27017/faculty_feedback
PORT=5000
JWT_SECRET=your_jwt_secret_here

# Local FastAPI Classifier Microservice (DeBERTa v3 zero-shot)
FASTAPI_CLASSIFIER_URL=http://localhost:7860

# HuggingFace Inference API token (free at huggingface.co/settings/tokens)
# Without this the API still works but is rate-limited to ~30 req/hr
HF_API_TOKEN=hf_your_token_here
